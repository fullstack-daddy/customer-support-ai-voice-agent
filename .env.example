# ============================================================
# RelayPay Support Agent — environment template
# Copy to `.env` and fill in real values. `.env` is gitignored.
# NOTHING in this file is a real credential.
# ============================================================

# --- Anthropic (required) ---------------------------------
# Powers the Claude Agent SDK backend that drives every call turn.
ANTHROPIC_API_KEY=
# Optional override. Defaults to a current Sonnet-class model.
CLAUDE_MODEL=

# --- Supabase (required) ----------------------------------
# Supabase dashboard -> Project Settings -> API
# Project URL only. No trailing slash, no /rest/v1 suffix.
SUPABASE_URL=
# "service_role" secret. SERVER-ONLY. Never expose to the browser,
# never put in a NEXT_PUBLIC_* variable, never log it.
SUPABASE_SERVICE_ROLE_KEY=
# "anon public" key. Only used if a narrowly-scoped client read is added
# later; the app currently reaches Supabase exclusively server-side.
SUPABASE_ANON_KEY=

# --- Vapi (required for voice) ----------------------------
# Vapi dashboard -> API Keys
VAPI_API_KEY=
# A long random string YOU invent. Paste the same value into the Vapi
# assistant's Server URL settings so inbound webhooks can be verified.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAPI_SERVER_SECRET=
# Public assistant id, safe to expose to the browser for the Web SDK widget.
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
# Public (publishable) Vapi key for the Web SDK widget. Not the private API key.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=

# --- Embeddings (optional) --------------------------------
# If neither is set, knowledge-base retrieval falls back to Postgres
# full-text search automatically. Voyage is Anthropic's recommended partner.
VOYAGE_API_KEY=
OPENAI_API_KEY=

# --- Admin console ----------------------------------------
# Single bootstrapped admin. There is no sign-up: the account is defined
# here and created on first successful login.
ADMIN_EMAIL=admin@relaypay.example
ADMIN_PASSWORD=
ADMIN_NAME=RelayPay Admin
# Signs the session cookie. 32+ random chars. Rotating it logs everyone out.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Email (required for sending ticket confirmations) -----
# Resend dashboard -> API Keys. https://resend.com
RESEND_API_KEY=
# Must be a domain you have verified in Resend, or sending is rejected.
EMAIL_FROM="RelayPay Support <support@yourdomain.com>"
# Where replies go. Falls back to EMAIL_FROM when unset.
EMAIL_REPLY_TO=

# --- Legacy ------------------------------------------------
# Previously gated /internal/review. The admin console replaces it;
# kept so an existing deployment does not break on upgrade.
INTERNAL_REVIEW_SECRET=

# --- App ---------------------------------------------------
# Public base URL of the deployed web app. Used for CORS allow-listing
# and for links inside generated summaries.
APP_BASE_URL=http://localhost:3000
# Comma-separated extra origins allowed to hit the API routes.
ALLOWED_ORIGINS=http://localhost:3000
