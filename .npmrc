# @anthropic-ai/claude-agent-sdk declares a peer dependency on zod ^4,
# while this repo is on zod 3 (packages/shared/src/tool-schemas.ts and
# packages/mcp-server/src/json-schema.ts both read zod 3 internals).
#
# The conflict is only a peer declaration: the SDK's zod-dependent code
# is its in-process `tool()` helper, which this project does not use —
# our tools live in a separate MCP server spoken to over stdio. The
# agent compiles and runs against the SDK without zod being involved.
#
# Without this flag `npm install` fails with ERESOLVE on a clean
# checkout, including on Vercel.
legacy-peer-deps=true
